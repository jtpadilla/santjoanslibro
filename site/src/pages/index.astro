---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { capitols, cataleg, href, llibre, numeroCapitol, render, slugOf, titolCurt } from '../lib/llibre';
import portada from '../../../assets/images/01-portada-paviment-del-salo.jpg';

const caps = await capitols();
const fitxes = await cataleg();
const taula = await Promise.all(
  caps.map(async (c) => {
    const { headings } = await render(c);
    return { c, apartats: headings.filter((h) => h.depth === 2 && h.slug !== 'footnote-label') };
  }),
);
---
<Base>
  <section class="portada">
    <Image src={portada} alt="El paviment ceràmic del saló principal de la casa Santjoans" width={520} loading="eager" />
    <h1>{llibre.titol}</h1>
    <p class="sub">{llibre.subtitol}</p>
    <p class="autora">{llibre.autora} · Maig 2010</p>
  </section>

  <p class="presentacio">L'estudi del paviment ceràmic zoomòrfic del saló noble del Palau Santjoans de Cinctorres: qui va alçar la casa, d'on van eixir les rajoles i un catàleg de {fitxes.length} peces. Va ser el treball de final de la Universitat per a Majors de l'autora (2010) i la Diputació de Castelló el va publicar en llibre el 2012. Les 434 rajoles del saló es poden recórrer una a una en el <a href="https://santjoans.es/">visor santjoans.es</a>, nascut del mateix treball.</p>

  <h2 style="margin-top:0">Índex</h2>
  <ul class="taula">
    {taula.map(({ c, apartats }) => (
      <li>
        <a class="cap" href={href(`${slugOf(c)}/`)}>
          <span class="n">{numeroCapitol(c.data.title) ?? '·'}</span>
          <span>{titolCurt(c.data.title)}</span>
          <span class="pag">{c.data.pages[0] === c.data.pages[1] ? `p. ${c.data.pages[0]}` : `p. ${c.data.pages[0]}–${c.data.pages[1]}`}</span>
        </a>
        {apartats.length > 0 && (
          <ol>
            {apartats.map((h) => <li><a href={href(`${slugOf(c)}/#${h.slug}`)}>{h.text}</a></li>)}
            {slugOf(c) === 'paviment' && <li><a href={href('cataleg/')}>Les {fitxes.length} rajoles del catàleg, en imatges</a></li>}
          </ol>
        )}
      </li>
    ))}
  </ul>
</Base>
